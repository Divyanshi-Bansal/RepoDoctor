# RepoDoctor Global Environment Variables Template
# Copy this file to .env for local development

# Database Connection (PostgreSQL 16 with pgvector)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=repodoctor
DB_PASSWORD=repodoctor_dev
DB_NAME=repodoctor
DB_LOGGING=false
DATABASE_URL=postgresql://repodoctor:repodoctor_dev@localhost:5432/repodoctor

# Redis Connection (Redis 7)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Backend API Configuration
PORT=3001
BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Web Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
