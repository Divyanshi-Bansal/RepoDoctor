{
  "name": "@repo-doctor/api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc --build",
    "start": "node dist/main.js",
    "start:dev": "ts-node -r ./test/cjs-ext-hook.cjs -r tsconfig-paths/register src/main.ts",
    "test": "vitest run",
    "test:integration": "node --require ./test/cjs-ext-hook.cjs --require ts-node/register/transpile-only --test 'src/graph-engine/__tests__/*.integration.spec.ts'",
    "typeorm": "ts-node -r ./test/cjs-ext-hook.cjs -r tsconfig-paths/register node_modules/typeorm/cli.js --dataSource src/database/data-source.ts",
    "migration:run": "pnpm run build && node node_modules/typeorm/cli.js --dataSource dist/database/data-source.js migration:run",
    "migration:revert": "pnpm run build && node node_modules/typeorm/cli.js --dataSource dist/database/data-source.js migration:revert"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.1",
    "@nestjs/core": "^10.4.1",
    "@nestjs/platform-express": "^10.4.1",
    "@nestjs/typeorm": "^10.0.2",
    "@types/bcryptjs": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "pg": "^8.12.0",
    "pgvector": "^0.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  }
}
