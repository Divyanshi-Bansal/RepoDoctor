# RepoDoctor Backend Environment Variables Template
# Copy to .env in backend/ or root for local development / production configuration

# Server Configuration
PORT=3001
NODE_ENV=development
BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Connection (PostgreSQL 16 with pgvector)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=repodoctor
DB_PASSWORD=repodoctor_dev
DB_NAME=repodoctor
DB_LOGGING=false
DATABASE_URL=postgresql://repodoctor:repodoctor_dev@localhost:5432/repodoctor

# Redis Connection (Redis 7)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Session Security
SESSION_MAX_AGE=28800
COOKIE_SECURE=false

# GitHub OAuth App Credentials (Optional for local email/password login; required for GitHub OAuth)
# Callback URL in GitHub App Settings: http://localhost:3001/auth/callback
GITHUB_APP_CLIENT_ID=Ov23li5ifKSzSqGgPFDu
GITHUB_APP_CLIENT_SECRET=bab940a9478bff63b419725fe38e493a38859d06
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3001/auth/callback

# GitLab OAuth App Credentials (Optional)
# Callback URL in GitLab App Settings: http://localhost:3001/auth/gitlab/callback
GITLAB_CLIENT_ID=Ov23li5ifKSzSqGgPFDu
GITLAB_CLIENT_SECRET=bab940a9478bff63b419725fe38e493a38859d06
GITLAB_OAUTH_REDIRECT_URI=http://localhost:3001/auth/gitlab/callback
